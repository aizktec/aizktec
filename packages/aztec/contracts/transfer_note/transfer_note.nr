use std;
use aztec.prelude::*;

/**
 * TransferNote Contract
 * This contract manages the private transfer of data ownership (Notes)
 * using Aztec's shielded transaction model.
 */

#[aztec.contract]
pub contract TransferNote {
    // The Note structure defines what is being transferred.
    // In this case, it's a simple ownership note containing a data hash.
    #[derive(aztec.note)]
    pub struct Note {
        pub owner: Address,
        pub data_hash: Field,
    }

    /**
     * transfer
     * Consumes an existing UTXO (Note) and creates a new one for the recipient.
     * 
     * @param old_note The note being consumed (provided as a private input)
     * @param new_owner The address of the recipient
     */
    pub fn transfer(old_note: Note, new_owner: Address) {
        // 1. Verify Ownership
        // Aztec's runtime automatically verifies that the caller has the 
        // right to consume 'old_note' via the ZK proof generated by the client.
        // However, we explicitly ensure the note's owner matches the expected logic.
        
        // In a real Aztec contract, the 'consume' action is implicit when 
        // the note is passed as an argument to a function that marks it as consumed.
        
        // 2. Validation
        // Ensure the new owner is not the same as the old owner to avoid redundant transactions.
        assert(old_note.owner != new_owner, "Recipient must be different from sender");

        // 3. Generate New UTXO
        // We create a new note with the same data_hash but assigned to the new_owner.
        let new_note = Note {
            owner: new_owner,
            data_hash: old_note.data_hash,
        };

        // 4. Emit the new note to the Aztec ledger
        // This creates the new UTXO in the shielded state.
        emit_note(new_note);
    }

    /**
     * mint
     * Helper function to initialize the first note in the system.
     */
    pub fn mint(owner: Address, data_hash: Field) {
        let note = Note {
            owner: owner,
            data_hash: data_hash,
        };
        emit_note(note);
    }
}
